# Copy to .env for local use, or set these in your host's dashboard.
PORT=3000
# REQUIRED in production: a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
# Where the SQLite database lives (put it on a persistent disk/volume in production)
DB_PATH=./data/gotrip.db
# Optional: creates/updates an admin account at boot (BD mobile number + 8+ char password)
ADMIN_PHONE=01700000000
ADMIN_PASSWORD=change-me-please
# Minutes a seat is held while the customer pays
HOLD_MINUTES=10
# Set to 1 when running behind a proxy/load balancer (Render, Fly, Nginx...)
TRUST_PROXY=0
# Public site URL (used in ticket verify links/QR), e.g. https://gotripbd.example.com
PUBLIC_URL=
# Set 0 to disable random "already sold" demo seats
DEMO_SOLD=1

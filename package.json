{
  "name": "go-trip-bd",
  "version": "1.0.0",
  "private": true,
  "description": "Go Trip BD - online bus ticketing platform for Bangladesh (Express + SQLite + vanilla JS)",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "reset-db": "node --env-file-if-exists=.env scripts/reset-db.js",
    "test": "node --env-file-if-exists=.env scripts/smoke-test.js"
  },
  "dependencies": {}
}
